diff --git a/models/customer_payments.sql b/models/customer_payments.sql
new file mode 100644
index 0000000..82c754a
--- /dev/null
+++ b/models/customer_payments.sql
@@ -0,0 +1,30 @@
+with payments as (
+
+    select * from {{ ref('stg_payments') }}
+
+),
+
+orders as (
+
+    select * from {{ ref('stg_orders') }}
+
+),
+
+final as (
+
+    select
+        orders.customer_id,
+        payments.payment_method,
+        count(payments.payment_id) as number_of_payments,
+        sum(payments.amount) as total_amount
+
+    from payments
+
+    left join orders
+        on payments.order_id = orders.order_id
+
+    group by orders.customer_id, payments.payment_method
+
+)
+
+select * from final
